{
  "name": "@jsdevlab/react-headless",
  "version": "1.0.0",
  "private": false,
  "description": "Type-safe headless logic components for React 19.",
  "keywords": ["react", "headless", "components", "logic", "typescript"],
  "repository": {
    "type": "git",
    "url": "https://github.com/jsdevlab/react-headless.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "README.zh-CN.md"],
  "scripts": {
    "build": "rslib",
    "changeset": "changeset",
    "check": "biome check --write",
    "dev": "rslib --watch",
    "format": "biome format --write",
    "prepare": "simple-git-hooks",
    "release": "changeset publish",
    "test": "tsc --noEmit -p tsconfig.test.json && rstest run",
    "test:coverage": "rstest run --coverage",
    "test:watch": "rstest --watch",
    "version": "changeset version"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check",
    "pre-push": "pnpm format"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rslib/core": "^1.0.6",
    "@rstest/adapter-rslib": "^0.12.6",
    "@rstest/core": "^0.12.6",
    "@rstest/coverage-v8": "^0.12.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.19.0 <27.0.0",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
